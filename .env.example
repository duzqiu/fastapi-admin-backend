# ===================== 基础配置 =====================
PROJECT_NAME=后台管理系统
DEBUG=true
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# ===================== 数据库 =====================
# 本地开发（默认）：SQLite，零配置
DATABASE_URL=sqlite:///./data/app.db

# 生产环境 - PostgreSQL（需 pip install "psycopg[binary]"）
# DATABASE_URL=postgresql+psycopg://postgres:postgres@127.0.0.1:5432/admin_db

# 生产环境 - MySQL（需 pip install PyMySQL）
# DATABASE_URL=mysql+pymysql://root:root@127.0.0.1:3306/admin_db?charset=utf8mb4

SQL_ECHO=false

# ===================== 安全 =====================
# 生产环境务必替换：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=please-change-this-secret-key-in-production-0123456789
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
REFRESH_TOKEN_EXPIRE_MINUTES=10080

# ===================== 跨域（前端独立部署时必填） =====================
# 多个来源用英文逗号分隔，不要带空格结尾
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===================== 初始管理员 =====================
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=admin123
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_NICKNAME=超级管理员

# ===================== 分页 =====================
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=200

# ===================== 用户中心：邮件（注册 / 重置密码验证码） =====================
# 本地开发建议保持 false：验证码直接打在控制台日志里，省得往真实邮箱发信。
# 想连 QQ 邮箱实测就把 MAIL_ENABLED 改成 true，并填上下面两项
# （注意：本地开发频繁向不存在的地址发信，可能被 QQ 判定为发信异常而限制账号）。
MAIL_ENABLED=false
# 465 → true（隐式 TLS）；587（Gmail 等 STARTTLS）→ false
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
MAIL_USE_SSL=true
MAIL_TIMEOUT=10
# MAIL_USERNAME = 你的 QQ 邮箱地址；MAIL_PASSWORD = QQ 邮箱的「SMTP 授权码」（不是登录密码）
MAIL_USERNAME=
MAIL_PASSWORD=
# 留空 = 用 MAIL_USERNAME 作为发件地址（推荐）；也可写「显示名 <你的QQ邮箱>」
MAIL_FROM=

# 验证码策略
EMAIL_CODE_LENGTH=6
EMAIL_CODE_EXPIRE_MINUTES=10
EMAIL_CODE_RESEND_SECONDS=60
EMAIL_CODE_MAX_ATTEMPTS=5
# 是否把验证码回显在接口响应的 debug_code 字段（仅本地联调，生产必须 false）
EMAIL_CODE_DEBUG_RETURN=true

# ===================== 图片上传（会员头像 / 菜品图片） =====================
# 相对路径以项目根目录为基准；对外访问地址为 {API_V1_PREFIX}/static/<文件>
UPLOAD_DIR=./data/uploads
IMAGE_MAX_SIZE_MB=5
IMAGE_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif
