# Docker 部署的环境变量模板（配套 docker-compose.yml 使用）
#
#   cp .env.docker.example .env      # 注意：文件名必须是 .env，compose 才会自动读取
#   然后按实际情况修改
#
# 原理：docker-compose.yml 里用的是 ${变量:-默认值} 插值，这个文件里的值会覆盖默认值。
# 本文件含数据库密码与 SECRET_KEY，已在 .gitignore / .dockerignore 中排除，不要提交。

# ===================== 数据库（宿主机上另一个 PG 容器）=====================
# 默认走宿主机映射端口：容器内访问 host.docker.internal = 宿主机
PG_HOST=host.docker.internal
# 宿主机映射出来的端口（PG 容器自身监听的是 5432，映射到宿主机是 5452）
PG_PORT=5452
PG_USER=postgres
PG_PASSWORD=123456
# 目标库必须已存在，后端只建表不建库：
#   docker exec -it <PG容器名> psql -U postgres -c "CREATE DATABASE admin_db;"
PG_DB=admin_db

# 备选：两容器接同一个自定义网络后，用「PG 容器名 + 容器内端口」直连（性能更好，不绕宿主机）
#   docker network create admin-net && docker network connect admin-net <PG容器名>
#   PG_HOST=<PG容器名>
#   PG_PORT=5432

# ===================== 构建期网络 / 镜像源（可选）=====================
# 只有「拉不动基础镜像 / 装不上依赖」时才需要改。默认值 = 官方源，正常网络下保持原样即可。
#
# 现象：failed to resolve source metadata for docker.io/library/python:3.13-slim:
#       403 Forbidden（加速器封了）/ 401 Unauthorized（加速器要鉴权）/ 5xx，域名就是 daemon 里配的加速器
# 原因：Docker daemon 的 Registry Mirror（加速器）失效了，`docker info` 可以看当前配的都有哪些。
# 公共加速器失效很频繁，建议直接用下面 B 的方式绕开，而不是跟着换加速器。
#
# 处理二选一：
#   A) 修 daemon：把 /etc/docker/daemon.json 里失效的 registry-mirrors 换掉或整段删掉（直连 Docker Hub），
#      再 systemctl restart docker；用 `docker pull python:3.13-slim` 验证。
#   B) 让本次构建绕过加速器：PYTHON_IMAGE 填「完整仓库地址」。
#      Docker 对带仓库域名的完整地址不再走 docker.io 的加速器，所以不受 daemon 配置影响。
#
#      先挑一个能用的（成功一个即可，不用全试；timeout 防止卡死）：
#        for i in docker.m.daocloud.io/library/python:3.13-slim \
#                 docker.1ms.run/library/python:3.13-slim \
#                 dockerproxy.net/library/python:3.13-slim ; do
#          timeout 90 docker pull "$i" >/dev/null 2>&1 && echo "OK   $i" || echo "FAIL $i"
#        done
#      然后把 OK 的那个填到下面（注意：只填基础镜像，别改 FROM 以外的写法）。
# 示例：PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.13-slim
PYTHON_IMAGE=python:3.13-slim

# Debian 软件源镜像（装 tzdata 用）。留空 = 用镜像自带的 deb.debian.org。
# APT_MIRROR=https://mirrors.aliyun.com/debian
APT_MIRROR=

# PyPI 源（装 requirements.txt 用）。留空/默认 = 官方 pypi.org。
# 注意用 https 的源，http 的源 pip 会拒装。
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
PIP_INDEX_URL=https://pypi.org/simple

# ===================== 容器通用 =====================
# 影响「菜品供应时段 / 每日限量」的判定，以及日志时间
TZ=Asia/Shanghai
# uvicorn 进程数
WEB_CONCURRENCY=2

# ===================== 后端：安全 =====================
# 生产必须替换，否则任何人都能伪造 JWT：
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-in-production-please-replace-me-0123456789
# 生产必须 false：true 会让验证码回显、错误信息暴露内部细节
DEBUG=false
# 前端实际访问地址（含协议与端口），多个用英文逗号分隔
BACKEND_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===================== 初始管理员（首次建表时创建）=====================
FIRST_SUPERUSER_USERNAME=admin
FIRST_SUPERUSER_PASSWORD=admin123
FIRST_SUPERUSER_EMAIL=admin@example.com
FIRST_SUPERUSER_NICKNAME=超级管理员

# ===================== 用户中心：邮件（QQ 邮箱，凭据已内置）=====================
# 本文件与 docker-compose.yml 的默认值里都带有真实账号与授权码，**会随仓库推送到 GitHub**
# （即凭据公开）。这么做是为了「拿到文件直接 up 就能发信」。风险与降低办法见 README
# 「在 Docker 里启用邮件」一节。
#
# 覆盖方式：把本文件 cp 成 .env 后改这里的值（.env 的值优先于 compose 里的默认值）。
# ⚠️ 若服务器上已存在旧 .env（里面的 MAIL_ENABLED=false / MAIL_HOST=smtp.example.com
#    会**覆盖**新默认值），请删掉或更新那几行，否则邮件发不出去。
# 改完必须重建容器才会生效：docker compose up -d --force-recreate backend（restart 不重读 .env）
MAIL_ENABLED=true
MAIL_HOST=smtp.qq.com
MAIL_PORT=465
# 465 → true（隐式 TLS）；587（Gmail 等 STARTTLS）→ false
MAIL_USE_SSL=true
MAIL_TIMEOUT=10
# QQ 邮箱账号；MAIL_PASSWORD 是该邮箱的「SMTP 授权码」（不是 QQ 登录密码）。
# 授权码在 QQ 邮箱后台「设置 → 账户 → 开启 SMTP 服务」生成；重新生成后旧码立即失效，
# 记得同步修改本文件与 docker-compose.yml 两处。
MAIL_USERNAME=duzqiu@qq.com
MAIL_PASSWORD=inblryakdtclbccj
# 发件人必须与 MAIL_USERNAME 完全一致（QQ 会校验「信封发件人 == 登录账号」，不一致会被拒发）
MAIL_FROM=duzqiu@qq.com
# 生产必须 false
EMAIL_CODE_DEBUG_RETURN=false

# ====================================================================
# 其余配置项（分页、验证码策略、图片大小限制等）在 app/core/config.py 里都有默认值，
# 需要覆盖时直接在 docker-compose.yml 的 backend.environment 下按同样的名字加一条即可。
# ====================================================================
